# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/taino
SPRING_DATASOURCE_USERNAME=taino
SPRING_DATASOURCE_PASSWORD=taino

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_BOT_USERNAME=YourBot
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# JWT (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_TTL_SECONDS=3600

# Mini App / CORS (frontend origin)
MINI_APP_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ImgBB (https://api.imgbb.com/)
IMGBB_API_KEY=your-imgbb-api-key
IMGBB_BASE_URL=https://api.imgbb.com

SERVER_PORT=8080
