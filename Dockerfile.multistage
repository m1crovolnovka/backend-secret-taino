# syntax=docker/dockerfile:1
# Optional full multi-stage build (Maven downloads inside Docker). Prefer the
# default Dockerfile + local `mvn package` when Maven Central is slow.

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app

COPY pom.xml .
COPY src ./src

RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -DskipTests -Dmaven.test.skip=true package \
    && test -f /app/target/taino-backend.jar

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN addgroup -S taino && adduser -S taino -G taino \
    && chown -R taino:taino /app

COPY --from=build --chown=taino:taino /app/target/taino-backend.jar /app/app.jar

USER taino
EXPOSE 8080
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
